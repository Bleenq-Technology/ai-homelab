# These files run inside Linux containers — always check out with LF endings,
# even on Windows, so shell scripts and configs don't break with CRLF.
* text=auto eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.env text eol=lf
*.env.example text eol=lf

