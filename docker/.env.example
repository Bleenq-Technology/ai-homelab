# ============================================================================
# Homelab shared environment — copy to .env and fill in real values on jarvis.
#   cp docker/.env.example docker/.env
# High-value credentials (EasyDNS API, etc.) live in docker/secrets/, NOT here.
# Every password below ships as a placeholder — change ALL of them before use.
# ============================================================================

# ---- Global ----------------------------------------------------------------
DOMAIN=lab.example
TZ=America/Los_Angeles
# ACME / Let's Encrypt registration email (cert expiry notices)
ACME_EMAIL=paul.vilevac@example.com

# ---- Shared SMTP (Mailjet) — reused by Keycloak, Grafana, NetBox, Baserow ----
# Outbound email: password resets, verification, alerts. User/password are the
# Mailjet API key / secret. FROM must be a Mailjet-verified sender.
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=mailjet_api_key
SMTP_PASSWORD=mailjet_secret_key
SMTP_FROM=jarvis@vilevac.com
SMTP_FROM_NAME=Vilevac Homelab

# ---- Alertmanager -> Discord -----------------------------------------------
# Discord webhook for Prometheus/Alertmanager metric alerts (temps, disk, OOM,
# restarts, PG connections, Redis memory). Reuses the Uptime Kuma alert channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# ---- content-curator "Librarian" bot ---------------------------------------
# Bot token (Developer Portal -> Bot tab -> Reset Token; ~70 chars, two dots).
# Consumed by the n8n "Discord Bot (header auth)" credential and the future gateway bot
# container. Not the OAuth2 Client Secret (that's a different, no-dot value).
DISCORD_BOT_TOKEN=your_librarian_bot_token_here

# ---- Traefik ---------------------------------------------------------------
# Dashboard basic-auth user. Generate the hash with:  htpasswd -nbB admin 'pass'
# Escape every $ as $$ when pasting into .env (compose interpolation).
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$REPLACE_WITH_BCRYPT_HASH

# ---- Homarr — dashboard ----------------------------------------------------
# Encrypts Homarr's stored integration secrets. 64-char hex; generate with:
#   openssl rand -hex 32
# Keep it stable — rotating it makes Homarr's saved integration creds undecryptable.
HOMARR_SECRET_ENCRYPTION_KEY=change_me_64_char_hex

# ---- Postgres (unified, service host = "postgres") -------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=change_me_superuser
# Per-service databases + roles (created by data/postgres init script)
KEYCLOAK_DB_PASSWORD=change_me_keycloak
NETBOX_DB_PASSWORD=change_me_netbox
INFISICAL_DB_PASSWORD=change_me_infisical
BASEROW_DB_PASSWORD=change_me_baserow
LANGFUSE_DB_PASSWORD=change_me_langfuse
MLFLOW_DB_PASSWORD=change_me_mlflow
N8N_DB_PASSWORD=change_me_n8n_db
LITELLM_DB_PASSWORD=change_me_litellm
CONTENT_CURATOR_DB_PASSWORD=change_me_discord_curator   # content-curator app: dc_links + dc_channels DB

# ---- Redis -----------------------------------------------------------------
REDIS_PASSWORD=change_me_redis

# ---- MinIO (S3) ------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_min8chars
# Bucket auto-created for Langfuse on startup
LANGFUSE_S3_BUCKET=langfuse
# Keycloak SSO for the MinIO console — set by core/keycloak/provision-minio-client.sh
MINIO_OIDC_CLIENT_SECRET=change_me_from_keycloak

# ---- ClickHouse ------------------------------------------------------------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change_me_clickhouse

# ---- QuestDB (time-series / market data) -----------------------------------
# Postgres-wire auth for SQL queries (Grafana/pgAdmin/markets app). ILP ingest
# on :9009 is unauthenticated on the LAN — see data/questdb/README.md.
QUESTDB_PG_USER=admin
QUESTDB_PG_PASSWORD=change_me_questdb

# ---- Keycloak (admin bootstrap) --------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin
# Bind password for the Samba AD DC (heimdall) WRITABLE LDAP federation —
# svc-keycloak. Real value lives in Infisical + .env only. See core/keycloak/
# provision-ldap-federation.sh and identity-infra/docs/ad-dc-build.md.
AD_LDAP_BIND_CREDENTIAL=change_me_svc_keycloak_bind

# ---- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# ---- Firezone (VPN) — generate strong randoms (openssl rand -base64 32) -----
FIREZONE_ADMIN_EMAIL=admin@lab.example
FIREZONE_ADMIN_PASSWORD=change_me_firezone
FIREZONE_SECRET_KEY_BASE=change_me_64_hex
FIREZONE_LIVE_VIEW_SIGNING_SALT=change_me_salt
FIREZONE_COOKIE_SIGNING_SALT=change_me_salt
FIREZONE_COOKIE_ENCRYPTION_SALT=change_me_salt
FIREZONE_OIDC_CLIENT_SECRET=change_me_from_keycloak

# ---- AI service secrets ----------------------------------------------------
OLLAMA_BASE_URL=http://jarvis:11434
N8N_ENCRYPTION_KEY=change_me_n8n_key
# Shared n8n REST API key (JWT) — drives n8n via the API (n8n-mcp, provisioning
# scripts). Mint in n8n -> Settings -> n8n API. Not consumed by compose; see
# docker/ai/n8n/n8n-mcp-setup.md.
N8N_API_KEY=change_me_n8n_api_key_jwt_from_n8n_settings
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=change_me_flowise
FLOWISE_SECRETKEY=change_me_flowise_secret
QDRANT_API_KEY=change_me_qdrant
NEO4J_PASSWORD=change_me_neo4j
SEARXNG_SECRET=change_me_searxng
LANGFUSE_NEXTAUTH_SECRET=change_me_langfuse_nextauth
LANGFUSE_SALT=change_me_langfuse_salt
LANGFUSE_ENCRYPTION_KEY=change_me_64_hex

# ---- Per-service admin/login & extras (services with built-in defaults) ----
NETBOX_ADMIN_EMAIL=admin@lab.example
NETBOX_ADMIN_PASSWORD=change_me_netbox_admin
PGADMIN_EMAIL=admin@lab.example
PGADMIN_PASSWORD=change_me_pgadmin
BASEROW_SECRET_KEY=change_me_baserow_secret
FIREZONE_DB_PASSWORD=change_me_firezone_db
INFISICAL_ENCRYPTION_KEY=change_me_infisical_enc_16b_hex
INFISICAL_AUTH_SECRET=change_me_infisical_auth_b64

# ---- AdGuard (admin is set in its first-run wizard; exporter logs in with these) ----
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=change_me_adguard
# DNS binds to this host IP only (host systemd-resolved holds 127.0.0.53:53)
ADGUARD_DNS_IP=192.168.2.10

# ---- AI LLM backend (local unsloth on the host, OpenAI-compatible :8888) ----
HOST_LAN_IP=192.168.2.10
UNSLOTH_API_KEY=sk-unsloth-replace_me

# ---- LiteLLM gateway (fronts unsloth) + Langfuse project keys (LLM tracing) ----
LITELLM_MASTER_KEY=sk-change_me
LANGFUSE_PUBLIC_KEY=pk-lf-from_langfuse_ui
LANGFUSE_SECRET_KEY=sk-lf-from_langfuse_ui
# Per-app LiteLLM virtual key for web-app (public chat BFF + its n8n node) — scoped to the
# chat model + bge-m3 only. Minted with /key/generate; revoke via /key/delete (kills the public bot).
WEB_APP_LLM_KEY=sk-web-app-from_litellm_key_generate
# Shared BFF<->n8n auth for the web-app public chat: the BFF sends it as the
# x-app-token header; the n8n workflow auth-gate Code nodes check it via $env.
# Fresh random secret (openssl rand -base64 32 / python -c 'secrets.token_urlsafe(32)').
WEB_APP_BFF_TOKEN=change_me_app_bff_token

# ---- GitHub PATs (feed n8n GitHub-API credentials for KB ingest) -----------
# GITHUB_PAT: fine-grained, org your-org, all repos, Contents:read — used by
#   the internal "KB GitHub (ai-homelab-infra RO)" credential (private kb_* ingest).
# GITHUB_READONLY_PAT: fine-grained, Contents:read, scoped to the PUBLIC OSS
#   ai-homelab repo ONLY — used by the web-app "KB GitHub (public RO)" credential.
GITHUB_PAT=github_pat_replace_me
GITHUB_READONLY_PAT=github_pat_public_oss_readonly_replace_me

# ---- Open WebUI web search (Tavily — LLM/RAG-optimized; SearXNG is the self-hosted fallback) ----
TAVILY_API_KEY=tvly-dev-from_tavily_dashboard

# ---- Off-host backup → Asustor NAS (restic REST server, append-only) -------
# backup.sh replicates the nightly dumps to the NAS via restic. See
# docs/off-host-backup.md. ASUSTOR_INTEGRATION_LOGIN is the NAS account / rest-server
# basic-auth user; RESTIC_REST_PASSWORD is that user's rest-server password (URL-safe
# hex — it embeds in the repo URL); RESTIC_PASSWORD is the repo *encryption* key
# (lose it = backups unrecoverable — it's also vaulted in the bootstrap set).
ASUSTOR_HOST_NAME=stor.lab.example
ASUSTOR_INTEGRATION_LOGIN=jarvis
ASUSTOR_INTEGRATION_PASSWORD=change_me_nas_account_password
RESTIC_REST_PASSWORD=change_me_url_safe_hex
RESTIC_PASSWORD=change_me_repo_encryption_key

# ---- Keycloak SSO — OIDC client secrets (generated in Keycloak; see core/keycloak/README.md) ----
# forward-auth bridge: oauth2-proxy (Keycloak client "oauth2-proxy"); sessions in Redis (DB 8)
OAUTH2_PROXY_CLIENT_SECRET=set_from_keycloak
OAUTH2_PROXY_COOKIE_SECRET=change_me_32_byte_base64
# native OIDC clients
GRAFANA_OIDC_CLIENT_SECRET=set_from_keycloak
OPENWEBUI_OIDC_CLIENT_SECRET=set_from_keycloak
PORTAINER_OIDC_CLIENT_SECRET=set_from_keycloak
LANGFUSE_OIDC_CLIENT_SECRET=set_from_keycloak
