# ============================================================================
# Homelab shared environment — copy to .env and fill in real values on jarvis.
#   cp docker/.env.example docker/.env
# High-value credentials (EasyDNS API, etc.) live in docker/secrets/, NOT here.
# Every password below ships as a placeholder — change ALL of them before use.
# ============================================================================

# ---- Global ----------------------------------------------------------------
DOMAIN=lab.example
TZ=America/Los_Angeles
# ACME / Let's Encrypt registration email (cert expiry notices)
ACME_EMAIL=paul.vilevac@example.com

# ---- Shared SMTP (Mailjet) — reused by Keycloak, Grafana, NetBox, Baserow ----
# Outbound email: password resets, verification, alerts. User/password are the
# Mailjet API key / secret. FROM must be a Mailjet-verified sender.
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_USER=mailjet_api_key
SMTP_PASSWORD=mailjet_secret_key
SMTP_FROM=jarvis@vilevac.com
SMTP_FROM_NAME=Vilevac Homelab

# ---- Alertmanager -> Discord -----------------------------------------------
# Discord webhook for Prometheus/Alertmanager metric alerts (temps, disk, OOM,
# restarts, PG connections, Redis memory). Reuses the Uptime Kuma alert channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# ---- content-curator "Librarian" bot ---------------------------------------
# Bot token (Developer Portal -> Bot tab -> Reset Token; ~70 chars, two dots).
# Consumed by the n8n "Discord Bot (header auth)" credential and the future gateway bot
# container. Not the OAuth2 Client Secret (that's a different, no-dot value).
DISCORD_BOT_TOKEN=your_librarian_bot_token_here

# ---- Traefik ---------------------------------------------------------------
# Dashboard basic-auth user. Generate the hash with:  htpasswd -nbB admin 'pass'
# Escape every $ as $$ when pasting into .env (compose interpolation).
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$REPLACE_WITH_BCRYPT_HASH

# ---- Homarr — dashboard ----------------------------------------------------
# Encrypts Homarr's stored integration secrets. 64-char hex; generate with:
#   openssl rand -hex 32
# Keep it stable — rotating it makes Homarr's saved integration creds undecryptable.
HOMARR_SECRET_ENCRYPTION_KEY=change_me_64_char_hex

# ---- Postgres (unified, service host = "postgres") -------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=change_me_superuser
# Per-service databases + roles (created by data/postgres init script)
KEYCLOAK_DB_PASSWORD=change_me_keycloak
NETBOX_DB_PASSWORD=change_me_netbox
INFISICAL_DB_PASSWORD=change_me_infisical
BASEROW_DB_PASSWORD=change_me_baserow
LANGFUSE_DB_PASSWORD=change_me_langfuse
MLFLOW_DB_PASSWORD=change_me_mlflow
N8N_DB_PASSWORD=change_me_n8n_db
LITELLM_DB_PASSWORD=change_me_litellm
CONTENT_CURATOR_DB_PASSWORD=change_me_discord_curator   # content-curator app: dc_links + dc_channels DB

# ---- Redis -----------------------------------------------------------------
REDIS_PASSWORD=change_me_redis

# ---- MinIO (S3) ------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_min8chars
# Bucket auto-created for Langfuse on startup
LANGFUSE_S3_BUCKET=langfuse
# Keycloak SSO for the MinIO console — set by core/keycloak/provision-minio-client.sh
MINIO_OIDC_CLIENT_SECRET=change_me_from_keycloak

# ---- ClickHouse ------------------------------------------------------------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change_me_clickhouse
# Read-only ClickHouse login for Grafana over the `scanner` research DB. The USER is
# created in ClickHouse's own SQL access store (not from this file) — see
# docker/data/clickhouse/README.md; only the password is carried here for Grafana.
CLICKHOUSE_SCANNER_RO_USER=scanner_ro
CLICKHOUSE_SCANNER_RO_PASSWORD=change_me_scanner_ro

# ---- QuestDB (time-series / market data) -----------------------------------
# Postgres-wire auth for SQL queries (Grafana/pgAdmin/markets app). ILP ingest
# on :9009 is unauthenticated on the LAN — see data/questdb/README.md.
QUESTDB_PG_USER=admin
QUESTDB_PG_PASSWORD=change_me_questdb

# ---- Redpanda (Kafka-API event/streaming spine) ----------------------------
# No secrets: the broker uses internal-network trust on the `data` network (no
# SASL), exactly like QuestDB's ILP — never host-publish 9092/8081/9644. The
# Console is gated by the shared oauth2-proxy (secure-sso), so it needs no
# per-app client either. If the Kafka API is ever exposed beyond `data`, enable
# SASL/SCRAM and add the credentials here. See data/redpanda/README.md.

# ---- Keycloak (admin bootstrap) --------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin
# Bind password for the Samba AD DC (heimdall) WRITABLE LDAP federation —
# svc-keycloak. Real value lives in Infisical + .env only. See core/keycloak/
# provision-ldap-federation.sh and identity-infra/docs/ad-dc-build.md.
AD_LDAP_BIND_CREDENTIAL=change_me_svc_keycloak_bind

# ---- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# ---- AI service secrets ----------------------------------------------------
OLLAMA_BASE_URL=http://jarvis:11434
N8N_ENCRYPTION_KEY=change_me_n8n_key
# Shared n8n REST API key (JWT) — drives n8n via the API (n8n-mcp, provisioning
# scripts). Mint in n8n -> Settings -> n8n API. Not consumed by compose; see
# docker/ai/n8n/n8n-mcp-setup.md.
N8N_API_KEY=change_me_n8n_api_key_jwt_from_n8n_settings
QDRANT_API_KEY=change_me_qdrant
NEO4J_PASSWORD=change_me_neo4j
SEARXNG_SECRET=change_me_searxng
LANGFUSE_NEXTAUTH_SECRET=change_me_langfuse_nextauth
LANGFUSE_SALT=change_me_langfuse_salt
LANGFUSE_ENCRYPTION_KEY=change_me_64_hex

# ---- Per-service admin/login & extras (services with built-in defaults) ----
NETBOX_ADMIN_EMAIL=admin@lab.example
NETBOX_ADMIN_PASSWORD=change_me_netbox_admin
PGADMIN_EMAIL=admin@lab.example
PGADMIN_PASSWORD=change_me_pgadmin
BASEROW_SECRET_KEY=change_me_baserow_secret
INFISICAL_ENCRYPTION_KEY=change_me_infisical_enc_16b_hex
INFISICAL_AUTH_SECRET=change_me_infisical_auth_b64

# ---- AdGuard (admin is set in its first-run wizard; exporter logs in with these) ----
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=change_me_adguard
# DNS binds to this host IP only (host systemd-resolved holds 127.0.0.53:53)
ADGUARD_DNS_IP=192.168.2.10

# ---- AI LLM backend (local unsloth on the host, OpenAI-compatible :8888) ----
HOST_LAN_IP=192.168.2.10
UNSLOTH_API_KEY=sk-unsloth-replace_me

# ---- LiteLLM gateway (fronts unsloth) + Langfuse project keys (LLM tracing) ----
# The MASTER key is an ADMINISTRATIVE credential (mints/revokes keys, reads all spend).
# It must not be a runtime credential for any app — every consumer gets its own scoped
# virtual key so traffic is attributable and boundable. Enforced by the AI-BOM drift
# check (`master_key_use`); see docs/ai-governance.md + docker/ai/inventory/README.md.
LITELLM_MASTER_KEY=sk-change_me
# Open WebUI's own scoped key (chat + bge-m3). Was the master key until 2026-07-22.
OPENWEBUI_LLM_KEY=sk-openwebui-from_litellm_key_generate
# n8n's KB flows and the content-curator flows each get their own scoped key, so
# traffic from the shared n8n container is attributable per SYSTEM (four different
# systems run in there). Both were the master key until 2026-07-22.
N8N_KB_LLM_KEY=sk-n8n-kb-from_litellm_key_generate
CONTENT_CURATOR_LLM_KEY=sk-content-curator-from_litellm_key_generate
# The governance eval suite (docker/ai/evals) — its own key so test traffic is
# separately attributable and budgeted, never mistaken for a real system's usage.
EVALS_LLM_KEY=sk-evals-from_litellm_key_generate
LANGFUSE_PUBLIC_KEY=pk-lf-from_langfuse_ui
LANGFUSE_SECRET_KEY=sk-lf-from_langfuse_ui
# Per-app LiteLLM virtual key for web-app (public chat BFF + its n8n node) — scoped to the
# chat model + bge-m3 only. Minted with /key/generate; revoke via /key/delete (kills the public bot).
WEB_APP_LLM_KEY=sk-web-app-from_litellm_key_generate
# Shared BFF<->n8n auth for the web-app public chat: the BFF sends it as the
# x-app-token header; the n8n workflow auth-gate Code nodes check it via $env.
# Fresh random secret (openssl rand -base64 32 / python -c 'secrets.token_urlsafe(32)').
WEB_APP_BFF_TOKEN=change_me_app_bff_token
# Per-app LiteLLM virtual key for example-site (The Example Playbook™ public chat)
# — a SEPARATE scoped key from web-app (chat model + bge-m3 only), so a leak on one public
# property cannot read the other's collection. Stays INTERNAL to n8n; never touches the public BFF.
EXAMPLE_SITE_LLM_KEY=sk-example-site-from_litellm_key_generate
# Shared BFF<->n8n auth for the example-site public chat — its OWN token, distinct from
# WEB_APP_BFF_TOKEN. Same x-app-token gate, separate isolated workflow.
EXAMPLE_SITE_BFF_TOKEN=change_me_modules_bff_token
# Cloudflare Tunnel run-token for chat.example-site.ai (remotely-managed tunnel; ingress +
# DNS live in Cloudflare). Consumed by the cloudflared service in the PLAYBOOK repo's
# deploy/prod/compose.public.yml — not by any service in this repo.
EXAMPLE_SITE_TUNNEL_TOKEN=change_me_cf_tunnel_run_token

# ---- GitHub PATs (feed n8n GitHub-API credentials for KB ingest) -----------
# GITHUB_PAT: fine-grained, org your-org, all repos, Contents:read — used by
#   the internal "KB GitHub (ai-homelab-infra RO)" credential (private kb_* ingest).
# GITHUB_READONLY_PAT: fine-grained, Contents:read, scoped to the PUBLIC OSS
#   ai-homelab repo ONLY — used by the web-app "KB GitHub (public RO)" credential.
GITHUB_PAT=github_pat_replace_me
GITHUB_READONLY_PAT=github_pat_public_oss_readonly_replace_me

# ---- GHCR image-pull credential (host `docker login ghcr.io`) ---------------
# The credential jarvis uses to PULL ghcr.io/your-org/* images. This is
# NOT the same as the GITHUB_*_PAT above (those are Contents:read GitHub-API
# tokens for KB ingest; GHCR pull needs read:packages). pull-secrets.sh does a
# `docker login ghcr.io` from these two values so the credential is managed, not
# a manual one-off. Use a READ-ONLY (read:packages) PAT — the host only pulls.
# Roll it: push-secret.sh GHCR_READONLY_PAT <new> && ./pull-secrets.sh  (todos #35).
GHCR_USERNAME=bleenq-paulv
GHCR_READONLY_PAT=ghp_replace_me_read_packages_pat

# ---- Open WebUI web search (Tavily — LLM/RAG-optimized; SearXNG is the self-hosted fallback) ----
TAVILY_API_KEY=tvly-dev-from_tavily_dashboard

# ---- Off-host backup → Asustor NAS (restic REST server, append-only) -------
# backup.sh replicates the nightly dumps to the NAS via restic. See
# docs/off-host-backup.md. ASUSTOR_INTEGRATION_LOGIN is the NAS account / rest-server
# basic-auth user; RESTIC_REST_PASSWORD is that user's rest-server password (URL-safe
# hex — it embeds in the repo URL); RESTIC_PASSWORD is the repo *encryption* key
# (lose it = backups unrecoverable — it's also vaulted in the bootstrap set).
ASUSTOR_HOST_NAME=stor.lab.example
ASUSTOR_INTEGRATION_LOGIN=jarvis
ASUSTOR_INTEGRATION_PASSWORD=change_me_nas_account_password
RESTIC_REST_PASSWORD=change_me_url_safe_hex
RESTIC_PASSWORD=change_me_repo_encryption_key

# ---- Keycloak SSO — OIDC client secrets (generated in Keycloak; see core/keycloak/README.md) ----
# forward-auth bridge: oauth2-proxy (Keycloak client "oauth2-proxy"); sessions in Redis (DB 8)
OAUTH2_PROXY_CLIENT_SECRET=set_from_keycloak
OAUTH2_PROXY_COOKIE_SECRET=change_me_32_byte_base64
# native OIDC clients
GRAFANA_OIDC_CLIENT_SECRET=set_from_keycloak
OPENWEBUI_OIDC_CLIENT_SECRET=set_from_keycloak
PORTAINER_OIDC_CLIENT_SECRET=set_from_keycloak
LANGFUSE_OIDC_CLIENT_SECRET=set_from_keycloak

# --- Cloudflare API (added 2026-07-14) -----------------------------------------------------------
# Two SCOPED tokens so Cloudflare is scriptable (DNS, Workers, Pages, Tunnels, redirects, TLS, email).
# Deliberately NOT a Global API Key: that one cannot be scoped, expired, or granularly revoked.
# Read them INSIDE the jarvis shell and pipe into curl so the value never leaves the host.
#
# GOTCHA: Cloudflare's /user/tokens/verify endpoint returns "Invalid API Token" for a PERFECTLY VALID
# token that merely lacks User-scope permissions. Do NOT use it as a health check. Make a real call.
CLOUDFLARE_ACCOUNT_TOKEN=cf_account_scoped_token_here
CLOUDFLARE_ZONES_TOKEN=cf_all_zones_scoped_token_here

# --- example-scanner: broker + market-data credentials (added 2026-07-18) -------------------------
# Flattened from the app's nested `secrets.json` (repo example-scanner, git-ignored, never committed).
# NAMING GOTCHA: the JSON calls the live taxable account `alpaca.markets`; the platform standardized
# on ALPACA_TAXABLE_* here, matching the keys that predate this import. Don't "fix" one to match the
# other — apps already reference TAXABLE.
# api_endpoint is carried alongside each credential ON PURPOSE: it's the paper-vs-live discriminator,
# so keeping it beside the key makes it much harder to point a LIVE key at the wrong base URL.
# Consumption: see SECRETS-INFISICAL.md in the example-scanner repo (env -> secrets.json shim).
ALPACA_TAXABLE_KEY=alpaca_live_key_here
ALPACA_TAXABLE_SECRET=alpaca_live_secret_here
ALPACA_TAXABLE_ACCOUNT_NUM=alpaca_account_number_here
ALPACA_TAXABLE_API_ENDPOINT=https://api.alpaca.markets
ALPACA_RETIREMENT_KEY=alpaca_live_key_here
ALPACA_RETIREMENT_SECRET=alpaca_live_secret_here
ALPACA_RETIREMENT_ACCOUNT_NUM=alpaca_account_number_here
ALPACA_RETIREMENT_API_ENDPOINT=https://api.alpaca.markets
ALPACA_PAPER_ONE_KEY=alpaca_paper_key_here
ALPACA_PAPER_ONE_SECRET=alpaca_paper_secret_here
ALPACA_PAPER_ONE_ACCOUNT_NUM=alpaca_paper_account_number_here
ALPACA_PAPER_ONE_API_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_PAPER_TWO_KEY=alpaca_paper_key_here
ALPACA_PAPER_TWO_SECRET=alpaca_paper_secret_here
ALPACA_PAPER_TWO_ACCOUNT_NUM=alpaca_paper_account_number_here
ALPACA_PAPER_TWO_API_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_PAPER_THREE_KEY=alpaca_paper_key_here
ALPACA_PAPER_THREE_SECRET=alpaca_paper_secret_here
ALPACA_PAPER_THREE_ACCOUNT_NUM=alpaca_paper_account_number_here
ALPACA_PAPER_THREE_API_ENDPOINT=https://paper-api.alpaca.markets
# Market-data / enrichment APIs. FMP also closes todos.md #30 (example-app's fundamentals source).
MARKETDATA_API_KEY=fmp_api_key_here
FINTEL_KEY=fintel_api_key_here
FINRA_CLIENT_ID=finra_oauth2_client_id_here
FINRA_CLIENT_SECRET=finra_oauth2_client_secret_here
# Distinct from DISCORD_WEBHOOK_URL — VERIFIED via the Discord webhook GET endpoint, not assumed:
# DISCORD_WEBHOOK_URL = "Jarvis Alerts" (channel 1516224428608852079, Alertmanager);
# EXAMPLE_APP_WEBHOOK = "Oracle Bot" (channel 1515807356712259757, scanner scanner).
# Same guild, different channels/webhook ids — do NOT collapse them into one key.
EXAMPLE_APP_WEBHOOK=https://discord.com/api/webhooks/xxx/yyy

# ── research-app desk — store credentials (ai-homelab-infra todos #31) ──────────────────────
# Provisioned 2026-07-20 on the SHARED jarvis stores (namespaces + credentials, not new stores —
# except a dedicated neo4j-example container). Full connection map + DSNs + the container-consume
# recipe live in the handoff note in the research-app repo (docs/infra/store-provisioning.md).
# Postgres db `research` — three least-privilege roles (migrate=DDL/owner, app=runtime RLS-bound,
# ro=read-only analytics). Provisioned by docker/data/postgres/provision-research.sh.
RESEARCH_MIGRATE_DB_PASSWORD=change_me_research_migrate
RESEARCH_APP_DB_PASSWORD=change_me_research_app
RESEARCH_RO_DB_PASSWORD=change_me_research_ro
# Dedicated neo4j-example container (Community edition — the isolation boundary is the container;
# see docker/data/compose.data.yml). Auth is neo4j/<this>.
RESEARCH_NEO4J_PASSWORD=change_me_research_neo4j
# MinIO bucket `research-artifacts` scoped service account (access key == the MinIO username).
RESEARCH_MINIO_ACCESS_KEY=research
RESEARCH_MINIO_SECRET_KEY=change_me_research_minio
# Redis logical DB index for the `research:*` keyspace (a namespace assignment, not a secret).
RESEARCH_REDIS_DB=8
# LiteLLM per-app virtual key — scoped to bge-m3 ONLY, never the master key.
RESEARCH_LLM_KEY=sk-research-virtual-key-here
