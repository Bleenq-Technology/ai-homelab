{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "title": "Markets — Scanner",
  "uid": "example-scanner",
  "tags": ["markets", "scanner", "clickhouse"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "1m",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat", "title": "Fires (range)", "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_scanner" },
      "targets": [ { "refId": "A", "editorType": "sql", "format": 1,
        "rawSql": "SELECT count() AS fires FROM scanner.events WHERE $__timeFilter(ts) AND type = 'trigger'" } ],
      "options": { "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "🤫 quiet fires", "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_scanner" },
      "targets": [ { "refId": "A", "editorType": "sql", "format": 1,
        "rawSql": "SELECT count() AS quiet FROM scanner.events WHERE $__timeFilter(ts) AND type = 'trigger' AND bucket = 'quiet'" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "📢 loud fires", "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_scanner" },
      "targets": [ { "refId": "A", "editorType": "sql", "format": 1,
        "rawSql": "SELECT count() AS loud FROM scanner.events WHERE $__timeFilter(ts) AND type = 'trigger' AND bucket = 'loud'" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "options": { "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Order fills (range)", "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_scanner" },
      "targets": [ { "refId": "A", "editorType": "sql", "format": 1,
        "rawSql": "SELECT count() AS fills FROM scanner.events WHERE $__timeFilter(ts) AND type = 'order' AND kind = 'fill'" } ],
      "options": { "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Risk skips (range)", "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_scanner" },
      "targets": [ { "refId": "A", "editorType": "sql", "format": 1,
        "rawSql": "SELECT count() AS skips FROM scanner.events WHERE $__timeFilter(ts) AND type = 'order' AND kind = 'skip'" } ],
      "options": { "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat", "title": "Book equity (latest)", "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_scanner" },
      "targets": [ { "refId": "A", "editorType": "sql", "format": 1,
        "rawSql": "SELECT sum(equity) AS book FROM (SELECT profile, argMax(equity, d) AS equity FROM scanner.equity GROUP BY profile)" } ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 0 } },
      "options": { "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries", "title": "Account equity (daily)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_scanner" },
      "targets": [ { "refId": "A", "editorType": "sql", "format": 0,
        "rawSql": "SELECT toDateTime(d) AS time, profile, equity FROM scanner.equity WHERE toDateTime(d) >= $__fromTime AND toDateTime(d) <= $__toTime ORDER BY time" } ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "custom": { "spanNulls": true } } }
    },
    {
      "type": "timeseries", "title": "Fires per day by model", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_scanner" },
      "targets": [ { "refId": "A", "editorType": "sql", "format": 0,
        "rawSql": "SELECT toStartOfDay(ts) AS time, model, toFloat64(count()) AS fires FROM scanner.events WHERE $__timeFilter(ts) AND type = 'trigger' GROUP BY time, model ORDER BY time" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80 } } }
    },
    {
      "type": "timeseries", "title": "Fires per day by runner bucket (anti-crowd read)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_scanner" },
      "targets": [ { "refId": "A", "editorType": "sql", "format": 0,
        "rawSql": "SELECT toStartOfDay(ts) AS time, if(bucket = '', 'unscored', bucket) AS bucket, toFloat64(count()) AS fires FROM scanner.events WHERE $__timeFilter(ts) AND type = 'trigger' GROUP BY time, bucket ORDER BY time" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "quiet" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "loud" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ] }
    },
    {
      "type": "timeseries", "title": "Order lifecycle per day", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_scanner" },
      "targets": [ { "refId": "A", "editorType": "sql", "format": 0,
        "rawSql": "SELECT toStartOfDay(ts) AS time, kind, toFloat64(count()) AS n FROM scanner.events WHERE $__timeFilter(ts) AND type = 'order' AND kind != '' GROUP BY time, kind ORDER BY time" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 80 } } }
    },
    {
      "type": "table", "title": "Recent fires", "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_scanner" },
      "targets": [ { "refId": "A", "editorType": "sql", "format": 1,
        "rawSql": "SELECT ts, model, symbol, if(bucket = '', 'unscored', bucket) AS bucket, round(runner_score, 2) AS score, entry, round(rr, 1) AS rr, round(conviction, 0) AS conv, quality, round(spy_day_pct, 2) AS spy_pct FROM scanner.events WHERE $__timeFilter(ts) AND type = 'trigger' ORDER BY ts DESC LIMIT 100" } ],
      "options": { "sortBy": [ { "displayName": "ts", "desc": true } ] }
    }
  ]
}
