  "title": "Stor — NAS (NVMe RAID5)",
  "uid": "stor-overview",
  "version": 1,
  "templating": { "list": [] },
  "panels": [
    { "type": "row", "title": "NAS Health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1, "collapsed": false, "panels": [] },
    {
      "type": "stat", "title": "Host reachable (node up)", "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 }, "id": 2,
      "targets": [ { "datasource": "Prometheus", "expr": "up{instance=\"stor\",job=\"node\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "type": "stat", "title": "SMB", "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 }, "id": 3,
      "targets": [ { "datasource": "Prometheus", "expr": "probe_success{job=\"blackbox-stor\",svc=\"smb\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "type": "stat", "title": "restic rest-server", "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 }, "id": 4,
      "targets": [ { "datasource": "Prometheus", "expr": "probe_success{job=\"blackbox-stor\",svc=\"restic-rest\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "index": 0 }, "1": { "text": "UP", "index": 1 } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "type": "stat", "title": "RAID5 failed disks", "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 }, "id": 5,
      "targets": [ { "datasource": "Prometheus", "expr": "node_md_disks{instance=\"stor\",device=\"md1\",state=\"failed\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "0 (OK)", "index": 0 } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },

    { "type": "row", "title": "Storage — RAID5 (md1) + btrfs pool", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "id": 10, "collapsed": false, "panels": [] },
    {
      "type": "stat", "title": "RAID5 active disks", "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 6 }, "id": 11,
      "targets": [ { "datasource": "Prometheus", "expr": "node_md_disks{instance=\"stor\",device=\"md1\",state=\"active\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 3 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "type": "gauge", "title": "Pool used % (/volume1)", "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 6 }, "id": 12,
      "targets": [ { "datasource": "Prometheus", "expr": "100 - (node_filesystem_avail_bytes{instance=\"stor\",mountpoint=\"/volume1\"} / node_filesystem_size_bytes{instance=\"stor\",mountpoint=\"/volume1\"} * 100)", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "type": "stat", "title": "Pool size", "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 6 }, "id": 13,
      "targets": [ { "datasource": "Prometheus", "expr": "node_filesystem_size_bytes{instance=\"stor\",mountpoint=\"/volume1\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "type": "stat", "title": "Pool free", "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 6 }, "id": 14,
      "targets": [ { "datasource": "Prometheus", "expr": "node_filesystem_avail_bytes{instance=\"stor\",mountpoint=\"/volume1\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 107374182400 }, { "color": "green", "value": 536870912000 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },

    { "type": "row", "title": "NVMe SMART — 3 drives", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 12 }, "id": 20, "collapsed": false, "panels": [] },
    {
      "type": "stat", "title": "SMART health", "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 }, "id": 21,
      "targets": [ { "datasource": "Prometheus", "expr": "smartctl_device_smart_status{instance=\"stor\"}", "legendFormat": "{{device}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "FAILING", "index": 0 }, "1": { "text": "PASSED", "index": 1 } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "timeseries", "title": "NVMe temperature", "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 16, "x": 8, "y": 13 }, "id": 22,
      "targets": [ { "datasource": "Prometheus", "expr": "smartctl_device_temperature{instance=\"stor\",temperature_type=\"current\"}", "legendFormat": "{{device}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "celsius", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 70 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "stat", "title": "NVMe wear (% rated life used)", "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 }, "id": 23,
      "targets": [ { "datasource": "Prometheus", "expr": "smartctl_device_percentage_used{instance=\"stor\"}", "legendFormat": "{{device}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },
    {
      "type": "stat", "title": "NVMe available spare", "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 }, "id": 24,
      "targets": [ { "datasource": "Prometheus", "expr": "smartctl_device_available_spare{instance=\"stor\"}", "legendFormat": "{{device}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 10 }, { "color": "green", "value": 50 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" }
    },

    { "type": "row", "title": "Compute", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 }, "id": 30, "collapsed": false, "panels": [] },
    {
      "type": "timeseries", "title": "CPU busy %", "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 27 }, "id": 31,
      "targets": [ { "datasource": "Prometheus", "expr": "100 - (avg(rate(node_cpu_seconds_total{instance=\"stor\",mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU busy", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } }
    },
    {
      "type": "timeseries", "title": "Load average", "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 27 }, "id": 32,
      "targets": [
        { "datasource": "Prometheus", "expr": "node_load1{instance=\"stor\"}", "legendFormat": "1m", "refId": "A" },
        { "datasource": "Prometheus", "expr": "node_load5{instance=\"stor\"}", "legendFormat": "5m", "refId": "B" },
        { "datasource": "Prometheus", "expr": "node_load15{instance=\"stor\"}", "legendFormat": "15m", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "gauge", "title": "Memory used %", "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 27 }, "id": 33,
      "targets": [ { "datasource": "Prometheus", "expr": "(1 - (node_memory_MemAvailable_bytes{instance=\"stor\"} / node_memory_MemTotal_bytes{instance=\"stor\"})) * 100", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 90 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showThresholdLabels": false, "showThresholdMarkers": true }
    },

    { "type": "row", "title": "Network & I/O", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }, "id": 40, "collapsed": false, "panels": [] },
    {
      "type": "timeseries", "title": "Network traffic (eth0/eth1)", "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 35 }, "id": 41,
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(node_network_receive_bytes_total{instance=\"stor\",device=~\"eth.*\"}[5m])", "legendFormat": "{{device}} rx", "refId": "A" },
        { "datasource": "Prometheus", "expr": "rate(node_network_transmit_bytes_total{instance=\"stor\",device=~\"eth.*\"}[5m])", "legendFormat": "{{device}} tx", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "NVMe disk I/O", "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 35 }, "id": 42,
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(node_disk_read_bytes_total{instance=\"stor\",device=~\"nvme.*n1\"}[5m])", "legendFormat": "{{device}} read", "refId": "A" },
        { "datasource": "Prometheus", "expr": "rate(node_disk_written_bytes_total{instance=\"stor\",device=~\"nvme.*n1\"}[5m])", "legendFormat": "{{device}} write", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
